# =====================================================
# PRONO 2026 — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# NE JAMAIS committer .env dans Git !
# =====================================================

# --- Sécurité (OBLIGATOIRE en production) ---
# Génère une clé robuste : python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change_me_remplace_par_une_cle_aleatoire_de_64_caracteres

# --- CORS (séparés par virgules, sans espace) ---
# En dev local : laisser tel quel
# En prod : mets uniquement ton domaine, ex: https://prono2026.fr,https://www.prono2026.fr
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost

# --- Port public du frontend ---
FRONTEND_PORT=80

# =====================================================
# DONS — Configurer 1, 2 ou 3 moyens
# Le bouton "Soutenir" apparaît dès qu'au moins 1 lien est rempli
# =====================================================

# Stripe Payment Link
# Crée-le sur : https://dashboard.stripe.com/payment-links
DONATION_STRIPE_LINK=

# PayPal.me
# Crée-le sur : https://paypal.me/
DONATION_PAYPAL_LINK=

# Ko-fi (le plus simple, sans frais)
# Crée-le sur : https://ko-fi.com
DONATION_KOFI_LINK=

# =====================================================
# CONTACT — formulaire (envoi des messages par email)
# Optionnel : si vide, les messages sont stockés en BDD uniquement
# (consultables dans l'onglet Admin → Messages)
# =====================================================

# Adresse de l'admin qui reçoit les messages
CONTACT_EMAIL=

# SMTP pour l'envoi (exemples ci-dessous)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Exemples de configuration SMTP ---
#
# Gmail (nécessite "Mot de passe d'application" : https://myaccount.google.com/apppasswords)
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=ton.email@gmail.com
#   SMTP_PASSWORD=xxxx_xxxx_xxxx_xxxx (mot de passe d'application 16 caractères)
#   SMTP_FROM=ton.email@gmail.com
#
# OVH
#   SMTP_HOST=ssl0.ovh.net
#   SMTP_PORT=465
#   SMTP_USER=ton.email@tondomaine.fr
#   SMTP_PASSWORD=ton_mot_de_passe
#
# Resend (recommandé en production : https://resend.com — 3000 emails gratuits/mois)
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USER=resend
#   SMTP_PASSWORD=re_xxxxxxxxxxxxxxx (clé API Resend)
#   SMTP_FROM=contact@tondomaine.fr

# =====================================================
# CLOUDFLARE TURNSTILE (anti-bot, optionnel mais recommandé en production)
# Gratuit, sans pubs, sans tracking — alternative à reCAPTCHA
# 1. Crée un site sur https://dash.cloudflare.com/?to=/:account/turnstile
# 2. Choisis "Managed" challenge (le moins intrusif pour les humains)
# 3. Copie les 2 clés ici
# Si vide, Turnstile est désactivé (les autres protections restent actives)
# =====================================================
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# =====================================================
# TRADUCTION (MyMemory)
# Email optionnel : x10 le quota gratuit (de 50k à 1M caractères/jour)
# Aucune inscription, juste un email valide qui sera identifié
# =====================================================
MYMEMORY_EMAIL=

# =====================================================
# TRADUCTION (LibreTranslate — backup si MyMemory échoue)
# Optionnel : URL d'une instance LibreTranslate self-hostée
# Si vide, on utilise les instances publiques par défaut
# =====================================================
LIBRETRANSLATE_URL=

# =====================================================
# RÉSULTATS DES MATCHS (Football-Data.org)
# Inscription gratuite : https://www.football-data.org/client/register
# Plan gratuit : 10 requêtes/min, suffisant pour le Mondial
# Sans clé : récupération automatique désactivée (saisie manuelle uniquement)
# =====================================================
FOOTBALL_DATA_API_KEY=

# =====================================================
# GOOGLE ANALYTICS 4 (suivi d'audience)
# Crée un compte : https://analytics.google.com
# Tu obtiens un ID au format G-XXXXXXXXXX
# Sans valeur : pas de tracking (respect maximum de la vie privée)
# =====================================================
GA_MEASUREMENT_ID=
