{
    email admin@unitedpronos.com
    # HTTP/1.1 et HTTP/2 uniquement.
    # HTTP/3 (QUIC) est désactivé car il pose problème avec
    # certains webviews mobiles (Instagram, TikTok) qui peuvent
    # casser la connexion ou afficher des erreurs SSL.
    servers {
        protocols h1 h2
    }
}

# ============================================================
# Redirection www → non-www
# ============================================================
www.unitedpronos.com {
    redir https://unitedpronos.com{uri} permanent
}

# ============================================================
# Site principal — unitedpronos.com
# HTTP → HTTPS automatique par Caddy
# Let's Encrypt SSL automatique (gratuit, renouvellement auto)
# ============================================================
unitedpronos.com {
    encode gzip

    # Autoriser les uploads de pièces jointes du chat (images base64) :
    # une image de 3 MB devient ~4 MB en base64. On laisse une marge confortable.
    request_body {
        max_size 10MB
    }

    reverse_proxy frontend:80

    # Headers de sécurité
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        -Server
    }

    # Cache long pour les assets statiques (JS, CSS, images)
    @static {
        path *.js *.css *.png *.jpg *.jpeg *.gif *.webp *.svg *.ico *.woff *.woff2 *.ttf
    }
    header @static Cache-Control "public, max-age=31536000, immutable"
}
